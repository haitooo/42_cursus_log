# Database (shared by mariadb and wordpress)
DB_NAME=wordpress
DB_USER=wpuser

# WordPress site
DOMAIN_NAME=<login>.42.fr
WP_TITLE=Inception

# WordPress users (passwords are in secrets/credentials.txt)
WP_ADMIN_USER=<username>
WP_ADMIN_EMAIL=<email>
WP_USER=<username>
WP_USER_EMAIL=<email>

# Bonus: FTP user (password is in secrets/ftp_password.txt)
FTP_USER=<username>

# Bonus: mail relay (Gmail app password is in secrets/mail_password.txt)
MAIL_RELAY_HOST=smtp.gmail.com
MAIL_RELAY_PORT=587
MAIL_RELAY_USER=<gmail address>
